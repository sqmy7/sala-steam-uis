# URL del backend de PrintWatch (DeteccionImpresion3d) extendido con los endpoints de la Sala
# STEAM. En local, con el backend corriendo en tu portatil:
VITE_API_BASE_URL=http://localhost:8000

# En produccion (GitHub Pages) esta variable se configura como "repository variable" en
# Settings -> Secrets and variables -> Actions -> Variables (VITE_API_BASE_URL), apuntando al
# Cloudflare Tunnel (u otro medio de exposicion) del backend. No se versiona ningun secreto aqui.
